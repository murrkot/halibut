.dataGridWidget {
    border: 2px solid #d3dae3;
    border-radius: 12px;
    background-color: #4a525e;
    color: #f5f7fa;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
}

.dataGridWidget table,
.dataGridWidget tbody,
.dataGridWidget tr,
.dataGridWidget td {
    border: none;
}

.dataGridHeader {
    background-color: #4a525e;
    color: #f5f7fa;
    font-weight: 700;
    border-bottom: 2px solid #d3dae3;
}

.dataGridFooter {
    background-color: #4a525e;
    color: #f5f7fa;
    border-top: 2px solid #d3dae3;
}

.dataGridEvenRow,
.dataGridOddRow {
    background-color: #0f141d;
    color: #f8fbff;
}

.dataGridCell,
.dataGridEvenRowCell,
.dataGridOddRowCell {
    background-color: #0f141d;
    color: #f8fbff;
    border-bottom: 1px solid #90a3b8;
}

.dataGridHoveredRow,
.dataGridHoveredRowCell {
    background-color: #161d28;
    color: #f8fbff;
}

.dataGridSelectedRow,
.dataGridSelectedRowCell,
.dataGridKeyboardSelectedRow,
.dataGridKeyboardSelectedRowCell,
.dataGridKeyboardSelectedCell {
    background-color: #d3dae3;
    color: #05131d;
}

.dataGridSelectedRow,
.dataGridKeyboardSelectedRow {
    box-shadow: inset 0 0 0 2px rgba(53, 194, 255, 0.35);
}

.halibutGridRowAdmin,
.halibutGridRowAdmin .dataGridCell,
.halibutGridRowAdmin .dataGridEvenRowCell,
.halibutGridRowAdmin .dataGridOddRowCell {
    background-color: #ffcccc;
    color: #05131d;
}

.halibutGridRowManager,
.halibutGridRowManager .dataGridCell,
.halibutGridRowManager .dataGridEvenRowCell,
.halibutGridRowManager .dataGridOddRowCell {
    background-color: #ffccff;
    color: #05131d;
}

.halibutGridRowUser,
.halibutGridRowUser .dataGridCell,
.halibutGridRowUser .dataGridEvenRowCell,
.halibutGridRowUser .dataGridOddRowCell {
    background-color: #ccffcc;
    color: #05131d;
}

.dataGridSelectedRow.halibutGridRowAdmin,
.dataGridSelectedRow.halibutGridRowManager,
.dataGridSelectedRow.halibutGridRowUser,
.dataGridKeyboardSelectedRow.halibutGridRowAdmin,
.dataGridKeyboardSelectedRow.halibutGridRowManager,
.dataGridKeyboardSelectedRow.halibutGridRowUser,
.dataGridSelectedRow.halibutGridRowAdmin .dataGridCell,
.dataGridSelectedRow.halibutGridRowManager .dataGridCell,
.dataGridSelectedRow.halibutGridRowUser .dataGridCell,
.dataGridKeyboardSelectedRow.halibutGridRowAdmin .dataGridCell,
.dataGridKeyboardSelectedRow.halibutGridRowManager .dataGridCell,
.dataGridKeyboardSelectedRow.halibutGridRowUser .dataGridCell {
    background-color: #d3dae3;
    color: #05131d;
}

